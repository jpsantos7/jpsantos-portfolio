---
// Header theme toggle (ticket 033, decision 009 variant A): one icon button that flips light
// and dark. State is aria-pressed (true = dark) on a fixed name, the standard toggle-button
// pattern: a screen reader hears one name plus "on/off", never a name that flips under it.
// The behaviour lives in the inline head script (src/scripts/theme-init.ts). Without JS the
// button stays hidden (CSS shows it under html.js) and the OS theme applies.
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle
      cx="12"
      cy="12"
      r="9"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    ></circle>
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
  </svg>
  <span class="visually-hidden">
    <!-- PLACEHOLDER: accessible name of the theme toggle. Pressed means dark, so the name must describe dark mode (for example a "dark theme" kind of label), not the action -->
    PLACEHOLDER: theme toggle name
  </span>
</button>
