---
// Base layout: head metadata, skip link, header, footer and the one <main> every page shares.
// global.css is imported once, first, so every page shares one ordered stylesheet.
import { Font } from "astro:assets";
import "../css/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { THEME_SCRIPT } from "../scripts/theme-init";
import { canonicalUrl, pageTitle } from "../utils/seo";

interface Props {
  /** Page name; the layout adds ` — JP Santos`. Ignored on Home. */
  title: string;
  /** Meta description, owner-written. Required: a missing one fails the build. */
  description: string;
  /** Home gets the `JP Santos — Design Engineer` title. */
  home?: boolean;
  /** Adds `noindex` and drops the canonical (404, "message sent"). */
  noindex?: boolean;
}

const { title, description, home = false, noindex = false } = Astro.props;

if (typeof description !== "string" || description.trim() === "") {
  throw new Error(
    `Base layout: "description" is required (page title: "${title}").`,
  );
}

const fullTitle = pageTitle(title, { home });
const canonical = noindex ? undefined : canonicalUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <!-- Inline on purpose: sets the saved theme before first paint. Justified and size-capped in src/scripts/theme-init.ts. -->
    <script is:inline set:html={THEME_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Heading and body are above the fold on every page, so they are preloaded.
         Label and emphasis load only when a page uses them. -->
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-label" />
    <Font cssVariable="--font-emphasis" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <!-- og:image and og:image:alt arrive with the OG card build (ticket 044). -->
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      <!-- PLACEHOLDER: skip link text (skip to main content) -->
      PLACEHOLDER: skip link text
    </a>
    <!-- The one duotone filter every Photo uses: luminance, gamma 0.5 mid-tones, then a
         table from ink (--color-ink, #161412) to yellow
         (--color-yellow, #f2c200); tests/photo-figure-components.test.ts derives the table values from
         those tokens. Same in dark mode; nothing is baked into
         image files. Takes no layout space (.duotone-defs). -->
    <svg class="duotone-defs" aria-hidden="true" focusable="false">
      <filter id="duotone" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values=".2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  .2126 .7152 .0722 0 0  0 0 0 1 0"
        />
        <feComponentTransfer>
          <feFuncR type="gamma" exponent="0.5" />
          <feFuncG type="gamma" exponent="0.5" />
          <feFuncB type="gamma" exponent="0.5" />
        </feComponentTransfer>
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.0863 0.949" />
          <feFuncG type="table" tableValues="0.0784 0.7608" />
          <feFuncB type="table" tableValues="0.0706 0" />
        </feComponentTransfer>
      </filter>
    </svg>
    <Header>
      <ThemeToggle slot="theme-toggle" />
    </Header>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
